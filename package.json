{
  "name": "freqx",
  "version": "1.6.0",
  "description": "Freqx desktop soundboard app",
  "main": "main.js",
  "author": "Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/reallav0/freqx.git"
  },
  "license": "ISC",
  "scripts": {
    "prepare:audio": "node scripts/prepare-audio.cjs",
    "prestart": "npm run prepare:audio",
    "start": "electron .",
    "predev": "npm run prepare:audio",
    "dev": "electron .",
    "prepack": "npm run prepare:audio",
    "pack": "electron-builder --dir",
    "predist": "npm run prepare:audio",
    "dist": "electron-builder --win",
    "postinstall": "node scripts/prepare-audio.cjs && electron-builder install-app-deps",
    "pretest:mic-isolation": "npm run prepare:audio",
    "test:mic-isolation": "node tests/mic-isolation.cjs",
    "test:recovery": "node tests/main-crash-recovery.cjs && node tests/crash-watchdog.cjs && node tests/recovery-integration.cjs"
  },
  "build": {
    "appId": "app.freqx.desktop",
    "productName": "freqx",
    "icon": "logo.ico",
    "protocols": [
      {
        "name": "freqx",
        "schemes": [
          "freqx"
        ]
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "asarUnpack": ["runtime/**/*"],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "deleteAppDataOnUninstall": true,
      "include": "installer/vbcable.nsh"
    },
    "extraResources": [
      {
        "from": "drivers",
        "to": "drivers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "crash.html",
      "crash.js",
      "index.html",
      "styles.css",
      "audio/**/*",
      "runtime/**/*",
      "assets/*.svg",
      "logo.png",
      "logo.ico",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "naudiodon": "^2.3.6",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "electron": "^36.0.0",
    "electron-builder": "^26.8.1"
  }
}
