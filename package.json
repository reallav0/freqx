{
  "name": "freqx",
  "version": "1.4.0",
  "description": "Freqx desktop soundboard app",
  "main": "main.js",
  "author": "Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/reallav0/freqx.git"
  },
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "native:install": "npm.cmd install --prefix native",
    "native:rebuild": "electron-rebuild -m native"
  },
  "build": {
    "appId": "app.freqx.desktop",
    "productName": "freqx",
    "icon": "logo.ico",
    "protocols": [
      {
        "name": "freqx",
        "schemes": [
          "freqx"
        ]
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "deleteAppDataOnUninstall": true,
      "include": "installer/vbcable.nsh"
    },
    "extraResources": [
      {
        "from": "drivers",
        "to": "drivers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "crash.html",
      "crash.js",
      "index.html",
      "styles.css",
      "logo.png",
      "logo.ico",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "naudiodon": "^2.3.6",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "node-gyp": "^10.2.0"
  }
}
